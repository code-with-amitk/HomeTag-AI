# Optional host-only settings; Kubernetes workloads use ConfigMaps and Secrets under k8s/.
# Do not use these development values in production.
POSTGRES_DB=hometag
POSTGRES_USER=hometag
POSTGRES_PASSWORD=hometag_dev_only
HOMETAG_DATABASE_URL=postgresql+psycopg://hometag:hometag_dev_only@localhost:5432/hometag
HOMETAG_REDIS_URL=redis://localhost:6379/0
HOMETAG_ENVIRONMENT=development
HOMETAG_LOG_LEVEL=INFO
HOMETAG_JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_chars
HOMETAG_ACCESS_TOKEN_MINUTES=30
